        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"backend\", area=\"heap\"})",
          "legendFormat": "堆已用",
          "refId": "Y25",
          "range": true,
          "instant": false
