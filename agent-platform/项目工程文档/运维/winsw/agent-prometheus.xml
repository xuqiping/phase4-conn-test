<!--
  运维系统 Step 8：Prometheus WinSW 服务定义（WinSW v2.12.0）
  用法：本文件与 WinSW.NET461.x64.exe（重命名为 agent-prometheus.exe）放同目录，
        管理员执行 agent-prometheus.exe install && agent-prometheus.exe start
  约定安装根：D:\IT\ops\prometheus\（换机器只改本文件路径与 prometheus.yml 约定）
-->
<service>
  <id>agent-prometheus</id>
  <name>agent-prometheus</name>
  <description>Agent Platform 运维系统：Prometheus 时序库（targets: backend:8080 sidecar:8090 windows_exporter:9182 自抓:9090）</description>
  <executable>D:\IT\ops\prometheus\prometheus.exe</executable>
  <arguments>--config.file=D:\IT\ops\prometheus\prometheus.yml --storage.tsdb.path=D:\IT\ops\prometheus\data --storage.tsdb.retention.time=15d --web.listen-address=127.0.0.1:9090</arguments>
  <workingdirectory>D:\IT\ops\prometheus</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <logpath>D:\IT\ops\prometheus\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
