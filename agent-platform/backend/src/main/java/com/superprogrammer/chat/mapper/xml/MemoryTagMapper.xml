<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.superprogrammer.chat.mapper.MemoryTagMapper">

    <resultMap id="MemoryTagMap" type="com.superprogrammer.chat.entity.MemoryTag" autoMapping="true">
        <id property="id" column="id"/>
        <result property="aliases" column="aliases" typeHandler="com.superprogrammer.common.typehandler.StringArrayTypeHandler"/>
    </resultMap>

    <!-- 写时归一首查：精确 (user, subject, topic) 命中（UNIQUE 兜底）。 -->
    <select id="findByUserSubjectTopic" resultMap="MemoryTagMap">
        SELECT * FROM memory_tags
        WHERE user_id = #{userId} AND subject = #{subject} AND topic = #{topic} AND deleted = 0
    </select>

    <!-- anchor 半向量近邻（粗筛主通道，D 迭代召回用；此处提前建好证 XML halfvec 转义启动期无异常——向量 1）。
         ⚠️ halfvec 算子 &lt;=&gt; 须转义，裸 &lt; 致 Spring 启动 mapper 解析崩（V33 教训）。 -->
    <select id="findNearestByAnchor" resultMap="MemoryTagMap">
        SELECT * FROM memory_tags
        WHERE user_id = #{userId} AND deleted = 0 AND anchor_embedding IS NOT NULL
        ORDER BY anchor_embedding &lt;=&gt; #{queryVec}::halfvec
        LIMIT #{limit}
    </select>
</mapper>
