<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.superprogrammer.chat.mapper.MemoryTurnMapper">

    <!-- 流水账可见范围过滤（向量 1/2）：
         自己的（user_id=self，含个人出身 + 后共享给项目的）OR 挂在 accessible 项目集内的（经 ACL，accessible 由 service 按 readableAuthors 算）。
         accessibleProjectIds 空集 → project_ids && '{}' = false → 只剩自己的。
         ⚠️ 数组重叠算子 && 在 XML 须转义为 &amp;&amp;，否则 mapper 解析崩。 -->
    <sql id="SCOPE_FILTER">
        AND (t.user_id = #{userId}
             OR t.project_ids &amp;&amp; #{accessibleProjectIds,typeHandler=com.superprogrammer.common.typehandler.LongArrayTypeHandler})
    </sql>

    <resultMap id="MemoryTurnMap" type="com.superprogrammer.chat.entity.MemoryTurn" autoMapping="true">
        <id property="id" column="id"/>
        <result property="tagIds"             column="tag_ids"              typeHandler="com.superprogrammer.common.typehandler.LongArrayTypeHandler"/>
        <result property="projectIds"         column="project_ids"          typeHandler="com.superprogrammer.common.typehandler.LongArrayTypeHandler"/>
        <result property="departedProjectIds" column="departed_project_ids" typeHandler="com.superprogrammer.common.typehandler.LongArrayTypeHandler"/>
        <result property="deletedProjectIds"  column="deleted_project_ids"  typeHandler="com.superprogrammer.common.typehandler.LongArrayTypeHandler"/>
    </resultMap>

    <!-- 当前用户可见的流水账。 -->
    <select id="findVisibleTurns" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0
        <include refid="SCOPE_FILTER"/>
        ORDER BY t.created_at DESC
    </select>

    <!-- 挂载项目（L11 多挂/卸用）。显式 typeHandler 绕开 LambdaUpdateWrapper 不读 typeHandler 的坑（V33 教训）。 -->
    <update id="updateProjectIds">
        UPDATE memory_turns
        SET project_ids = #{projectIds,typeHandler=com.superprogrammer.common.typehandler.LongArrayTypeHandler},
            updated_at  = NOW()
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- ============================ 计划12 · D-5 拼流水账 ⑥ ============================ -->

    <!-- 个人 scope 可召回 turns：本人 born_personal=true AND gen_done=true（项目出身/ raw 不进）。
         ⚠️ born_personal=true 限定（设计§3.3 line114）；direction/timeWindow 过滤 created_at。 -->
    <select id="findPersonalRecallableTurns" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0 AND t.gen_done = true
          AND t.user_id = #{userId} AND t.born_personal = true
          <if test="direction != null and direction != 'BOTH'">AND t.direction = #{direction}</if>
          <if test="relativeDays != null">AND t.created_at &gt;= NOW() - make_interval(days =&gt; #{relativeDays})</if>
          <if test="twStart != null">AND t.created_at &gt;= #{twStart}</if>
          <if test="twEnd != null">AND t.created_at &lt;= #{twEnd}</if>
        ORDER BY t.created_at DESC
    </select>

    <!-- 项目 scope 可召回 turns：project_ids 含 X 且 user_id ∈ readableAuthors AND gen_done=true。
         readableAuthorIds 须非空（Patcher 空集 skip）；&& 转义 &amp;&amp;。 -->
    <select id="findProjectRecallableTurns" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0 AND t.gen_done = true
          AND t.project_ids &amp;&amp; ARRAY[#{projectId}]::bigint[]
          AND t.user_id IN
          <foreach collection="readableAuthorIds" item="aid" open="(" separator="," close=")">
              #{aid}
          </foreach>
          <if test="direction != null and direction != 'BOTH'">AND t.direction = #{direction}</if>
          <if test="relativeDays != null">AND t.created_at &gt;= NOW() - make_interval(days =&gt; #{relativeDays})</if>
          <if test="twStart != null">AND t.created_at &gt;= #{twStart}</if>
          <if test="twEnd != null">AND t.created_at &lt;= #{twEnd}</if>
        ORDER BY t.created_at DESC
    </select>

    <!-- ============================ 计划12 · E 总结取数 + backfill + DISCARD 级联 ============================ -->

    <!-- E-3 个人总结取数：born_personal=true AND gen_done=true AND tag_ids 含任一 tagId。
         tag_ids && 是数组重叠（须 &amp;&amp; 转义）；direction/timeWindow 过滤 created_at。 -->
    <select id="findPersonalTurnsForConsolidation" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0 AND t.gen_done = true
          AND t.user_id = #{userId} AND t.born_personal = true
          AND t.tag_ids &amp;&amp;
              <foreach collection="tagIds" item="tid" open="ARRAY[" separator="," close="]::bigint[]">
                  #{tid}
              </foreach>
          <if test="direction != null and direction != 'BOTH'">AND t.direction = #{direction}</if>
          <if test="relativeDays != null">AND t.created_at &gt;= NOW() - make_interval(days =&gt; #{relativeDays})</if>
          <if test="twStart != null">AND t.created_at &gt;= #{twStart}</if>
          <if test="twEnd != null">AND t.created_at &lt;= #{twEnd}</if>
        ORDER BY t.created_at ASC
    </select>

    <!-- E-3 项目总结取数：project_ids 含 X AND user_id ∈ authorIds AND gen_done=true AND tag_ids 含任一 tagId。 -->
    <select id="findProjectTurnsForConsolidation" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0 AND t.gen_done = true
          AND t.project_ids &amp;&amp; ARRAY[#{projectId}]::bigint[]
          AND t.user_id IN
          <foreach collection="authorIds" item="aid" open="(" separator="," close=")">
              #{aid}
          </foreach>
          AND t.tag_ids &amp;&amp;
              <foreach collection="tagIds" item="tid" open="ARRAY[" separator="," close="]::bigint[]">
                  #{tid}
              </foreach>
          <if test="direction != null and direction != 'BOTH'">AND t.direction = #{direction}</if>
          <if test="relativeDays != null">AND t.created_at &gt;= NOW() - make_interval(days =&gt; #{relativeDays})</if>
          <if test="twStart != null">AND t.created_at &gt;= #{twStart}</if>
          <if test="twEnd != null">AND t.created_at &lt;= #{twEnd}</if>
        ORDER BY t.created_at ASC
    </select>

    <!-- E-3 STALE 重生取数：按 id 集回读未软删 turn（created_at 升序喂 LLM 保时序）。 -->
    <select id="findTurnsByIds" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0
        <if test="turnIds != null and turnIds.size() > 0">
            AND t.id IN
            <foreach collection="turnIds" item="tid" open="(" separator="," close=")">#{tid}</foreach>
        </if>
        <if test="turnIds == null or turnIds.size() == 0">AND 1 = 0</if>
        ORDER BY t.created_at ASC
    </select>

    <!-- E-2 backfill 取数：scope 内 gen_done=false 的 raw turn，LIMIT ≤20/批。
         bornPersonal=true → 个人 raw（born_personal=true）；否则项目 raw（project_ids 含 X）。 -->
    <select id="findRawTurnsForBackfill" resultMap="MemoryTurnMap">
        SELECT t.* FROM memory_turns t
        WHERE t.deleted = 0 AND t.gen_done = false AND t.user_id = #{userId}
        <choose>
            <when test="bornPersonal">AND t.born_personal = true</when>
            <otherwise>AND t.project_ids &amp;&amp; ARRAY[#{projectId}]::bigint[]</otherwise>
        </choose>
        ORDER BY t.created_at ASC
        LIMIT #{limit}
    </select>

    <!-- E-2 backfill 写回：补 tag_ids + L1/L2 + gen_done=true（显式 typeHandler 绕 LambdaUpdateWrapper 坑，V33 教训）。 -->
    <update id="applyBackfill">
        UPDATE memory_turns
        SET tag_ids    = #{tagIds,typeHandler=com.superprogrammer.common.typehandler.LongArrayTypeHandler},
            l1_summary = #{l1Summary},
            l2_detail  = #{l2Detail},
            gen_done   = true,
            updated_by = #{updatedBy},
            updated_at = NOW()
        WHERE id = #{id} AND deleted = 0
    </update>

    <!-- E-4 DISCARD 连带软删 source turns（显式 deleted=1，供级联批量；返实删条数）。 -->
    <update id="softDeleteByIds">
        UPDATE memory_turns SET deleted = 1, updated_at = NOW()
        WHERE deleted = 0
        <if test="turnIds != null and turnIds.size() > 0">
            AND id IN
            <foreach collection="turnIds" item="tid" open="(" separator="," close=")">#{tid}</foreach>
        </if>
        <if test="turnIds == null or turnIds.size() == 0">AND 1 = 0</if>
    </update>
</mapper>
