<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.superprogrammer.chat.mapper.MemoryProjectEntryMapper">

    <!-- 显式 resultMap：不依赖全局 mapUnderscoreToCamelCase（承 MemoryTagMapper 范式）。 -->
    <resultMap id="EntryVOMap" type="com.superprogrammer.chat.dto.MemoryProjectEntryVO">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="authorUserId" column="author_user_id"/>
        <result property="authorName" column="author_name"/>
        <result property="l1Summary" column="l1_summary"/>
        <result property="l2Detail" column="l2_detail"/>
        <result property="confidence" column="confidence"/>
        <result property="status" column="status"/>
        <result property="contentType" column="content_type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 项目条目列表：status 过滤；authorUserId 非空时收窄（成员仅看自己产生的，FR-005）。
         ⚠️ 永不 select raw_content（本表就没有原文字段，原文不出个人域）。 -->
    <select id="listByProject" resultMap="EntryVOMap">
        SELECT e.id, e.project_id, e.author_user_id,
               COALESCE(u.name, u.username) AS author_name,
               e.l1_summary, e.l2_detail, e.confidence, e.status, e.content_type, e.created_at
        FROM memory_project_entries e
        LEFT JOIN users u ON u.id = e.author_user_id
        WHERE e.deleted = 0 AND e.project_id = #{projectId}
        <if test="status != null and status != ''"> AND e.status = #{status} </if>
        <if test="authorUserId != null"> AND e.author_user_id = #{authorUserId} </if>
        ORDER BY e.created_at DESC
        LIMIT 200
    </select>
    <!-- 召回合流 VO 映射（多 tag_ids，走 LongArrayTypeHandler）。 -->
    <resultMap id="EntryRecallVOMap" type="com.superprogrammer.chat.dto.MemoryProjectEntryVO">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="authorUserId" column="author_user_id"/>
        <result property="authorName" column="author_name"/>
        <result property="l1Summary" column="l1_summary"/>
        <result property="l2Detail" column="l2_detail"/>
        <result property="confidence" column="confidence"/>
        <result property="status" column="status"/>
        <result property="contentType" column="content_type"/>
        <result property="createdAt" column="created_at"/>
        <result property="projectName" column="project_name"/>
        <result property="tagIds" column="tag_ids" typeHandler="com.superprogrammer.common.typehandler.LongArrayTypeHandler"/>
    </resultMap>

    <!-- 召回合流（FR-007 ①.5 + 二期 P2 FR-102）：一批项目内全部 ACTIVE 条目。
         projectIds 已由 service 层过滤为读者可读集（成员项目 ∪ ACTIVE 授权 child，单级一跳）。
         join projects 取项目名 → 授权条目装配「来自授权项目·X」标注。 -->
    <select id="listActiveForRecall" resultMap="EntryRecallVOMap">
        SELECT e.id, e.project_id, e.author_user_id,
               COALESCE(u.name, u.username) AS author_name,
               e.l1_summary, e.l2_detail, e.confidence, e.status, e.content_type, e.created_at, e.tag_ids,
               p.name AS project_name
        FROM memory_project_entries e
        LEFT JOIN users u ON u.id = e.author_user_id
        LEFT JOIN projects p ON p.id = e.project_id
        WHERE e.deleted = 0 AND e.status = 'ACTIVE'
          AND e.project_id IN
          <foreach collection="projectIds" item="pid" open="(" separator="," close=")">
              #{pid}
          </foreach>
        ORDER BY e.created_at DESC
        LIMIT 200
    </select>
</mapper>
