<!-- 运维系统 Step 13：sidecar WinSW 服务定义模板（OPS-FR-22） -->
<!-- 部署（服务器、管理员）：
     1. WinSW.NET461.exe 改名 agent-sidecar.exe，与本 xml 一起放 E:\agent-platform\runtime-sidecar\
     2. 确认 python 路径与依赖已装（pip install -r requirements.txt）
     3. agent-sidecar.exe install && agent-sidecar.exe start -->
<!-- 偏离说明：99-部署要求 §七-E 原文 --host 0.0.0.0；安全策略与 /actuator 一致改为只绑 127.0.0.1
     （后端同机调用 + Prometheus 同机抓取都走 localhost，外部访问由防火墙/Nginx 层杜绝） -->
<service>
  <id>agent-sidecar</id>
  <name>agent-sidecar</name>
  <description>agent-platform 工作流 sidecar（FastAPI/uvicorn），仅监听 127.0.0.1:8090</description>
  <executable>python</executable>
  <arguments>-m uvicorn app.main:app --host 127.0.0.1 --port 8090</arguments>
  <workingdirectory>E:\agent-platform\runtime-sidecar</workingdirectory>
  <logpath>E:\agent-platform\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
</service>
