<!--
  运维系统 Step 8：Alertmanager WinSW 服务定义（WinSW v2.12.0）
  用法：本文件与 WinSW.NET461.x64.exe（重命名为 agent-alertmanager.exe）放同目录，
        管理员执行 agent-alertmanager.exe install && agent-alertmanager.exe start
  注意：alertmanager.yml 含钉钉 webhook/SMTP 密钥，不入库——部署时从 alertmanager.yml.example 复制填写。
        Step 10 落地前本服务装了也先不启动也行（无规则引用），但一并装好减少窗口动作。
-->
<service>
  <id>agent-alertmanager</id>
  <name>agent-alertmanager</name>
  <description>Agent Platform 运维系统：Alertmanager 告警路由（钉钉+邮件兜底，配置不入库）</description>
  <executable>D:\IT\ops\alertmanager\alertmanager.exe</executable>
  <arguments>--config.file=D:\IT\ops\alertmanager\alertmanager.yml --storage.path=D:\IT\ops\alertmanager\data --web.listen-address=127.0.0.1:9093</arguments>
  <workingdirectory>D:\IT\ops\alertmanager</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <logpath>D:\IT\ops\alertmanager\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
