<?xml version="1.0" encoding="UTF-8"?>
<!-- agent-platform/backend/src/main/resources/logback-spring.xml
  三个 appender：
    CONSOLE     —— 控制台（INFO+，带颜色，开发看）
    FILE        —— 全量日志文件（INFO+，审查用），滚动 50MB × 30 天 × 上限 2GB
    ERROR_FILE  —— 仅 ERROR 级（快速翻问题），滚动 20MB × 30 天 × 上限 1GB
  日志级别由 application.yml 的 logging.level.* 驱动（Spring Boot 应用层覆盖），此处不重复声明 logger 级别。
  路径可用环境变量覆盖：LOG_FILE（全量）、ERROR_LOG_FILE（错误）。云上 Docker 挂卷指这两个。
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 全量日志文件路径：读 application.yml logging.file.name（默认 logs/agent-platform.log），可被 LOG_FILE 覆盖 -->
    <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="logs/agent-platform.log"/>
    <!-- 错误日志文件路径：默认 logs/error.log，可被 ERROR_LOG_FILE 覆盖 -->
    <springProperty name="ERROR_LOG_FILE" source="logging.file.error-name" defaultValue="logs/error.log"/>

    <!-- ===== 控制台：INFO+，彩色（开发主用） ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== 全量文件：INFO+（审查用） ===== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ===== ERROR-only 文件：只收 ERROR（快速定位故障） ===== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ERROR_LOG_FILE}</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ERROR_LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
