<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.superprogrammer.chat.mapper.MemoryConflictMapper">

    <!-- V47 计划12：新模型冲突（带 tag_id + summary_id），强制 user_id scope（向量 6）。
         复杂特型列（new_memory/existing_memory_ids 等）不选——旧列 H 收尾随旧表语义废弃。 -->
    <select id="findByUser" resultType="com.superprogrammer.chat.entity.MemoryConflict">
        SELECT id, user_id, session_id, tag_id, summary_id, status, resolution, created_at, resolved_at
        FROM memory_conflicts
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>
</mapper>
