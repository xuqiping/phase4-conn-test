<!-- 运维系统 Step 10：钉钉 webhook 适配器 WinSW 服务定义（OPS-FR-12） -->
<!-- 部署：与 WinSW.NET461.exe 同目录且 exe 改名为 agent-dingtalk-webhook.exe（WinSW 要求 exe/xml 同名配对） -->
<!-- 作用：把 Alertmanager 的 webhook 报文转译成钉钉机器人格式；不装它钉钉机器人会拒收 -->
<service>
  <id>agent-dingtalk-webhook</id>
  <name>agent-dingtalk-webhook</name>
  <description>agent-platform 告警钉钉通道适配器（prometheus-webhook-dingtalk v2.1.0），仅监听 127.0.0.1:8060</description>
  <executable>D:\IT\ops\dingtalk-webhook\prometheus-webhook-dingtalk.exe</executable>
  <arguments>--web.listen-address=127.0.0.1:8060 --config.file=D:\IT\ops\dingtalk-webhook\config.yml</arguments>
  <logpath>D:\IT\ops\dingtalk-webhook\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
</service>
