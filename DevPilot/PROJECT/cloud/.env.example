# DevPilot 云端环境变量样例（复制为 .env；生产值走密钥管理，不入库不入 git）
PORT=3000

# PostgreSQL（本地开发 = docker compose 的 pg）
DATABASE_URL=postgresql://devpilot:devpilot_dev@localhost:5432/devpilot

# Redis（验证码限频 / JWT 黑名单 / 搜索缓存）
REDIS_URL=redis://localhost:6379

# JWT（生产换强随机值；access 15min / refresh 7d）
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too

# 上游模型 Key 落库加密密钥（AES-GCM，32 字节 base64）
API_IDENTITY_ENC_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# 体验金与开关（运维清单：配置开关）
GIFT_CENTS_ON_REGISTER=500
GIFT_ENABLED=true
SEARCH_BOCHA_ENABLED=false
SEARCH_ZHIPU_ENABLED=false

# 支付回调验签（MVP 假渠道 HMAC）
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret
