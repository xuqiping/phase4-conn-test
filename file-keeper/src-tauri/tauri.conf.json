{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "File Keeper",
  "version": "0.1.0",
  "identifier": "com.filekeeper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "File Keeper",
        "width": 1280,
      "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
    "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "File Keeper Team",
    "copyright": "Copyright © 2026 File Keeper Team. All rights reserved.",
    "category": "Utility",
    "shortDescription": "轻量级文件快速访问工具",
    "longDescription": "File Keeper 是一个轻量级的文件快速访问工具，通过可视化的卡片界面帮助用户管理和快速打开常用文件。支持分组、标签、搜索和多种排序方式，提供虚拟滚动和图标懒加载等性能优化。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
    "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
